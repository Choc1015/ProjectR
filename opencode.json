{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-flash",
  "small_model": "deepseek/deepseek-flash",
  "mcp": {
    "unreal": {
      "type": "remote",
      "url": "http://127.0.0.1:8010/mcp",
      "enabled": true
    },
    "blender": {
      "type": "local",
      "command": ["cmd", "/c", "uvx", "--python", "3.12", "blender-mcp"],
      "environment": { "UV_PYTHON_INSTALL_DIR": "C:\\Users\\lytyy\\.uv\\python" },
      "enabled": true
    }
  },
  "permission": {
    "blender_*": "deny"
  }
}
